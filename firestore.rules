rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Physicians collection - authenticated users can read/write
    match /physicians/{physicianId} {
      allow read, write: if request.auth != null;
      
      // Physician preferences subcollection
      match /preferences/{preferenceId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Facilities collection - authenticated users can read/write
    match /facilities/{facilityId} {
      allow read, write: if request.auth != null;
    }
    
    // Contacts collection - authenticated users can read/write
    match /contacts/{contactId} {
      allow read, write: if request.auth != null;
    }
    
    // Surgical cases collection - authenticated users can read/write
    match /surgical_cases/{caseId} {
      allow read, write: if request.auth != null;
      
      // Validate required fields for case creation
      allow create: if request.auth != null 
        && request.resource.data.keys().hasAll(['case_type', 'physician_id', 'facility_id', 'date', 'time'])
        && request.resource.data.case_type is string
        && request.resource.data.physician_id is string
        && request.resource.data.facility_id is string;
    }
    
    // Tray requirements collection - read for all authenticated, write for admins
    match /tray_requirements/{requirementId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }
    
    // Physician preferences collection - authenticated users can read/write
    match /physician_preferences/{preferenceId} {
      allow read, write: if request.auth != null;
    }
    
    // Activities collection - authenticated users can read/write
    match /activities/{activityId} {
      allow read, write: if request.auth != null;
      
      // Auto-set user_id on create
      allow create: if request.auth != null && 
        request.resource.data.user_id == request.auth.uid;
    }
    
    // Appointments collection - authenticated users can read/write
    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null;
    }
    
    // Tray tracking collection - authenticated users can read/write
    match /tray_tracking/{trayId} {
      allow read, write: if request.auth != null;
      
      // Validate tray status updates
      allow update: if request.auth != null &&
        request.resource.data.status in ['available', 'in_use', 'cleaning', 'maintenance', 'missing'];
    }
    
    // Analytics collection - read only for authenticated users
    match /analytics/{analyticsId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }
    
    // System configuration - admin only
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }
  }
}

